{
    "manufacturer": "Slashosting.xyz",
    "keyboard_name": "pacropad",
    "maintainer": "Glixie",
    "bootloader": "rp2040",
    "processor": "RP2040",

    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },

    "matrix_pins": {
        "direct": [
            [
                "GP28",
                "GP29",
                "GP6",
                "GP7",
                "GP27",
                "GP26",
                "GP2",
                "GP4",
                "GP3"
            ]
        ]
    },

    "encoder": {
        "rotary": [
            {
                "pin_a": "GP1",
                "pin_b": "GP0"
            }
        ]
    },

    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 1], "x": 1, "y": 0 },
                { "matrix": [0, 2], "x": 2, "y": 0 },
                { "matrix": [0, 3], "x": 3, "y": 0 },
                { "matrix": [0, 4], "x": 4, "y": 0 },
                { "matrix": [0, 5], "x": 5, "y": 0 },
                { "matrix": [0, 6], "x": 6, "y": 0 },
                { "matrix": [0, 7], "x": 7, "y": 0 },
                { "matrix": [0, 8], "x": 8, "y": 0 }
            ]
        }
    }
}